<?xml version="1.0" encoding="utf-8"?>
<!--
  Dot — theme. Silver and black, bright and sharp: silver faceplate
  chrome, near-black charcoal base, white text.
  Parent is the PLATFORM Material theme, not Theme.Material3:
  Theme.Material3.DayNight.NoActionBar lives in the Views Material
  library (com.google.android.material:material), which Dot does not
  depend on — the Compose material3 library carries no XML theme.
  Compose handles in-app theming (see DotTheme in MainActivity);
  this parent only sets the window chrome.
  Copyright (c) 2026 Dot contributors. All rights reserved.
-->
<resources>
    <style name="Theme.Dot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1A1A1A</item>
        <item name="android:navigationBarColor">#1A1A1A</item>
        <item name="android:statusBarColor">#1A1A1A</item>
    </style>
</resources>
